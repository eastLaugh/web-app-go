# Token 密码（用于生成和验证 token）
EASTLAUGH_TOKEN_PWD=your_secret_token_password_here

# OpenAI 兼容 API（必填；可用 DeepSeek / OpenAI 等）
OPENAI_API_KEY=sk-your-api-key-here
# 非 OpenAI 官方时填写，如 DeepSeek: https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# 对话模型，如 gpt-4o-mini / deepseek-chat
# OPENAI_MODEL=gpt-4o-mini
# 向量模型，如 text-embedding-3-small
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# MongoDB 连接字符串
EASTLAUGH_MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>?retryWrites=true&w=majority

# HTTP 地址
EASTLAUGH_ADDR=:8080
EASTLAUGH_CONSOLE_ADDR=localhost:2333

# 用于 docker compose

# Token 密码（用于生成和验证 token）
EASTLAUGH_TOKEN_PWD=your_secret_token_password_here

# 数据库驱动（mysql 或 sqlite3）
EASTLAUGH_DATABASE_DRIVER=mysql

# MySQL 数据库连接字符串
# 格式: user:password@tcp(host:port)/dbname?charset=utf8mb4&parseTime=True&loc=Local
EASTLAUGH_DATABASE_DSN=user:password@tcp(localhost:3306)/webapp?charset=utf8mb4&parseTime=True&loc=Local

# DeepSeek API Key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# MongoDB 连接字符串
EASTLAUGH_MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>?retryWrites=true&w=majority

# HTTP 地址
EASTLAUGH_ADDR=:8080

# Mongo Express 密码 用于 docker compose
MONGO_EXPRESS_ROOT_PASSWORD=
{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Connect to server",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "substitutePath": [
                {
                    "from": "${workspaceFolder}",
                    "to": "/app/go",
                },{
                    "from": "/home/minami/go/pkg",
                    "to": "/go/pkg",
                }
            ],
            "port": 2345,
            "host": "127.0.0.1",
            // "console": "integratedTerminal",
        },
        {
            "name": "调试服务器",
            "type": "go",
            "request": "launch",
            "program": "${workspaceFolder}/",
            //使用.env
            "envFile": "${workspaceFolder}/../.env",
            "console": "integratedTerminal",
        },
        {
            "name": "测试cnllm",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/pkg/cnllm",
            //使用.env
            "envFile": "${workspaceFolder}/../.env",
            "console": "integratedTerminal",
        },
        {
            "name": "测试mongo",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/mongo_test.go",
            //使用.env
            "envFile": "${workspaceFolder}/../.env",
            "console": "integratedTerminal",
        }
    ]
}